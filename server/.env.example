# Supabase
SUPABASE_URL=your_key
SUPABASE_ANON_KEY=your_key
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# AWS SES
# AWS_REGION=your_key
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_key
# SES_VERIFIED_EMAIL=your_key

# Resend
RESEND_API_KEY=your_key
RESEND_FROM_EMAIL=your_key

# App / Server Config
PORT=3000               # your Express server port

# JWT secret for encryption of session token
JWT_SECRET=your_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://mail-merge-*.vercel.app
